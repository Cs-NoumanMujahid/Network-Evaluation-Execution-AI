# Public domain or IP address of the VPS (required for production setup)
NEXA_PUBLIC_DOMAIN=yourdomain.com

# Firewall mode ('docker' for local docker-exec, 'host' for direct sudo iptables DOCKER-USER on the VPS)
NEXA_FIREWALL_MODE=host

# Backend URL used by ML Consumer to report threats
NEXA_BACKEND_URL=http://host.docker.internal:8000

# Django production settings
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-strong-random-key-here
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,yourdomain.com
DJANGO_CORS_ALLOWED_ORIGINS=https://yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com
